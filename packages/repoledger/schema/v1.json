{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shazhou-ww/skills/raw/refs/heads/main/packages/repoledger/schema/v1.json",
  "title": "repoledger configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "remote",
    "branch"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "tasksDirectory": {
      "type": "string",
      "default": "tasks",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    }
  }
}