{
  "name": "shared-agent-skills-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "repoledger": "workspace:*",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "check": "pnpm --filter repoledger check && pnpm check:release && pnpm check:ledger",
    "check:ledger": "node packages/repoledger/bin/repoledger.js check",
    "check:release": "node --check scripts/prepare-npm-release.mjs && node --test test/prepare-npm-release.test.mjs",
    "check:skills": "npx skills add . --list",
    "prepare:npm-release": "node scripts/prepare-npm-release.mjs",
    "test": "pnpm --filter repoledger test && pnpm test:release",
    "test:release": "node --test test/prepare-npm-release.test.mjs"
  }
}